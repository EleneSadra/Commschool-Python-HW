import logging

logging.basicConfig(filename='game.log', level=logging.DEBUG,
                    format='%(asctime)s - %(message)s')

questions = [
    ("2 + 2", 4),
    ("5 * 3", 15),
    ("10 - 7", 3),
    ("8 / 2", 4),
