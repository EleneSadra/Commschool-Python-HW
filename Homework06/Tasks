# გამოცნობის შემთხვევაში “50%”
import random

words = ["ananasi", "kompoti", "banani", "kosmosi", "veraperi",
         "simgera", "gveleshapi", "datvi", "navti", "alubali"]

chosen = random.sample(words, 2)
correct = 0

for word in chosen:
    indices = random.sample(range(len(word)), 2)
    hidden = list(word)
    for i in indices:
        hidden[i] = "_"
    print("Guess the word: " + "".join(hidden))
    
    guess = input("Your answer: ")
    if guess == word:
        correct += 1

if correct == 2:
    print("You Won! ʕ•́ᴥ•̀ʔっ♡")
elif correct == 1:
    print("50% (ㆆ_ㆆ)")
