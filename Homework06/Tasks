#3 შექმენი დეკორატორი, რომელიც ითვლის რამდენჯერ გამოიძახეს ფუნქცია.
# მაგალითი:
# @counter
# def say():
# print("Hi")
# say()
# say()
# გამოძახება: 1
# Hi
# გამოძახება: 2

def my_decorator(func):
    count = [0]
    def wrapper():
        count[0] += 1
        print(f"Times called out: {count}")
        func()
    return wrapper

@my_decorator
def say_hi():
    print("hi")

say_hi()

# #4 მომხმარებელს უნდა დავუსვათ 5 მათემატიკური შეკითხვა, თითოეულზე სწორი
