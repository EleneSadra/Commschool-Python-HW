# \#9 იღბლიანი დაბადების დღე
# მოთამაშემ უნდა შეიყვანოს დაბადების თარიღი და თამაში დაითვლის რამდენი დღეა დარჩენილი შემდეგ დაბადების დღემდე
# birthday = date(2000, 12, 10)

from datetime import date, timedelta
birthday = input("Input your Birthday to calculate days left (Year, Month, Day): ")
today = date.today()
parts = [int(x.strip("()")) for x in birthday.split(',')]
birth_year, birth_month, birth_day = parts[0], parts[1], parts[2]

next_birthday = date(today.year, birth_month, birth_day)
if next_birthday <= today:
    next_birthday = date(today.year + 1, birth_month, birth_day)

days_left = next_birthday - today

print(f"There's {days_left.days} days left until your next Birthday!")